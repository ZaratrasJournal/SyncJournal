# Environments / system
.env
.env.*
*.local
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/

# Dependencies
node_modules/
proxy-local/node_modules/
proxy-local/package-lock.json
package-lock.json

# Personal trade-data exports — never commit
*.csv
*.xlsx
*.xls
*.zip
*_private.json
*_personal.*

# Generated demo data (regenereerbaar via scripts/gen-demo-backup.js)
morani-demo-backup.json

# Snapshot exports (kan persoonlijke positionId's bevatten)
blofin-snapshot-*.json
mexc-snapshot-*.json
kraken-snapshot-*.json
hyperliquid-snapshot-*.json
okx-snapshot-*.json

# Lokale test-fixtures voor parser-tests (real-data snapshots + CSVs)
# Tests staan wel in git, fixtures niet. Tests skippen automatisch wanneer
# fixture-files ontbreken zodat CI op GitHub blijft slagen.
tests/_fixtures/

# Local backups + scratch
/backups/
_scratch/

# graphify — afgeleide/lokale kennisgraaf (regenereerbaar, niet committen).
# graphify-src/ = uit tradejournal.html geëxtraheerde JS; graphify-out/ = graaf + rapport.
graphify-out/
graphify-src/

# Playwright test infrastructure
playwright-report/
test-results/
# Alleen baseline-screenshots committen, geen one-off output
tests/screenshots/**/*.png
!tests/screenshots/baseline/
!tests/screenshots/baseline/**

# Distributie-builds (gebundelde datasets) — build-artefacten, niet committen
dist/
deploy/

# Persoonlijke journal-backups — bevatten exchange-credentials (apiKey/apiSecret/passphrase).
# Nooit committen, ook niet met een afwijkende naam of extensie.
syncjournal-backup-*
tradejournal-backup-*
*-backup-*.json

# Remotion intro-video: afhankelijkheden, opnames en renders zijn zwaar en regenereerbaar.
video/node_modules/
video/out/
video/.capture/

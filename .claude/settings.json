{
  "permissions": {
    "allow": [
      "WebFetch(domain:leerob.io)",
      "WebFetch(domain:leerob.com)",
      "Bash(git push origin main)",
      "Bash(git push origin work)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-theme-tokens.js"
          }
        ]
      }
    ]
  }
}

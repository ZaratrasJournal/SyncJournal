# Cloudflare Pages headers — version.json mag nooit cachen (update-check),
# de app-pagina en de landingspagina revalideren altijd zodat een release direct doorkomt.
/version.json
  Cache-Control: no-store
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/app
  Cache-Control: no-cache
/app.html
  Cache-Control: no-cache
/privacy.html
  Cache-Control: no-cache
